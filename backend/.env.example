# Plantilla de variables del backend. Copiar como backend/.env y completar.
# backend/.env está ignorado por git; nunca versionar valores reales.

# --- Base de datos ---
MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/recetario
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
PORT=3000

# --- Google Identity (OAuth 2.0) ---
# client_id público del cliente web autorizado en Google Cloud Console.
# Debe coincidir con el origen desde el que se abre el frontend
# (por ejemplo, http://localhost:4200 y https://tu-dominio.com).
# Sin esta variable, GET /api/config devuelve "" y el login con Google no se muestra.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Correo (recuperación de contraseña) ---
# Gmail requiere una contraseña de aplicación, no la contraseña normal de la cuenta.
# Sin SMTP_HOST, SMTP_USER y SMTP_PASS, POST /api/auth/forgot-password responde 503.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion
MAIL_FROM="Sazón <tu-cuenta@gmail.com>"
